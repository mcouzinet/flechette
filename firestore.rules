rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user saved game results (unchanged)
    match /game_results/{resultId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Remote play sessions — trust-based shared board.
    // Any authenticated user (incl. anonymous) who knows the random code may
    // read and update the session; the unguessable code is the access secret.
    // Only the host may create the doc, under their own uid.
    match /sessions/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code == code
                    && request.resource.data.actions.size() == 0;

      // Trust-based but locked down: writers may move only the gameplay fields.
      // Identity/meta fields are frozen and the action log is capped, so a
      // participant can't hijack the host, swap the game, or bloat the doc
      // (which every client replays through the reducer).
      allow update: if request.auth != null
                    && request.resource.data.hostUid   == resource.data.hostUid
                    && request.resource.data.gameId    == resource.data.gameId
                    && request.resource.data.code      == resource.data.code
                    && request.resource.data.players   == resource.data.players
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.actions.size() <= 2000;

      allow delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user saved game results (unchanged)
    match /game_results/{resultId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Remote play sessions — trust-based shared board.
    // Any authenticated user (incl. anonymous) who knows the random code may
    // read and update the session; the unguessable code is the access secret.
    // Only the host may create the doc, under their own uid.
    match /sessions/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code == code
                    && request.resource.data.actions.size() == 0;

      // TRUST MODEL: the random code is a shared *edit token*, not an integrity
      // boundary. Identity/meta (host/game/code/players/config/createdAt) are
      // frozen and the action log is capped, but action *contents* are NOT
      // validated here — a participant could append arbitrary actions out of
      // band (every client replays them through the reducer, which stays robust
      // to garbage). Acceptable for casual play among people who share the code;
      // move appends server-side if integrity ever matters.
      allow update: if request.auth != null
                    && request.resource.data.hostUid   == resource.data.hostUid
                    && request.resource.data.gameId    == resource.data.gameId
                    && request.resource.data.code      == resource.data.code
                    && request.resource.data.players   == resource.data.players
                    && request.resource.data.config    == resource.data.config
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.actions.size() <= 2000;

      allow delete: if false;
    }
  }
}
